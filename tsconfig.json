{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "circuitsvibe": ["src/forge.ts"],
      "circuitsvibe/arduino": ["src/mcu/arduino.ts"]
    },
    "types": ["node"]
  },
  "include": ["src", "bench"],
  "exclude": ["bench/broken/syntax.fw.ts"]
}
