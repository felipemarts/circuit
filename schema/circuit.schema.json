{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:circuitsvibe:schema:circuitsvibe-circuit:1",
  "title": "CircuitsVibe circuit document (circuitsvibe-circuit/1)",
  "description": "Language-neutral circuit document: components and wiring, free parameters, assertions with their analysis configs, optional metadata, embedded sources, viewer layout and the printed circuit board (pcb, lengths in mm). Spec: docs/CIRCUIT-FORMAT.md. All quantities are SI numbers (ohm, F, H, V, A, s, Hz, dB, degrees). Cross-field rules this schema cannot express (unique ids, pins exactly matching the component type, references to components and nets) are checked by validateCircuitDoc and reported as T010-T014.",
  "type": "object",
  "required": [
    "schema",
    "name",
    "components",
    "assertions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "circuitsvibe-circuit/1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "nets": {
      "description": "User-named nets (probe-able), ascending. gnd and n<digits> are reserved and never listed.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/userNetName"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "overrides": {
      "description": "Scalar overrides applied when the document was made; component params already contain them.",
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "ratings": {
      "description": "Datasheet-rating check settings (tb.ratings) when they differ from the defaults { enabled: true, derate: 1, pd: 'average', ignore: [] }; only non-default keys are written. ignore lists component ids (checked by validateCircuitDoc).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "derate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "pd": {
          "enum": [
            "average",
            "peak"
          ]
        },
        "ignore": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "sources": {
      "description": "Embedded text files: VHDL, firmware and custom-component modules (paths referenced by component params and definitions[].source). Carried verbatim.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "language",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!\\.\\.?(/|$))[^/\\\\:]+(/(?!\\.\\.?(/|$))[^/\\\\:]+)*$"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9+#.-]*$"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "definitions": {
      "$ref": "#/$defs/definitions"
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "pcb": {
      "$ref": "#/$defs/pcb"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "netName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "userNetName": {
      "type": "string",
      "pattern": "^(?!gnd$)(?!n[0-9]+$)[A-Za-z][A-Za-z0-9_]*$"
    },
    "paramValue": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paramValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/paramValue"
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "type",
        "params",
        "pins"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/paramValue"
          }
        },
        "pins": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/netName"
          }
        },
        "free": {
          "type": "object",
          "required": [
            "min",
            "max",
            "scale"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "scale": {
              "enum": [
                "lin",
                "log"
              ]
            }
          }
        },
        "modelCard": {
          "description": "Verbatim SPICE .model card of a Diode/LED/NPN/PNP/NMOS/PMOS built with fromModel(card); re-read on load for its lint diagnostics (T005-T008). Electrical values come from params, whose model must name the same card.",
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string"
        }
      }
    },
    "scalarCheck": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "min",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "within"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "value",
            "tol"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "closeTo"
            },
            "value": {
              "type": "number"
            },
            "tol": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "above"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "below"
            },
            "value": {
              "type": "number"
            }
          }
        }
      ]
    },
    "dcCheck": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "x",
            "check"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "at"
            },
            "x": {
              "type": "number"
            },
            "check": {
              "$ref": "#/$defs/scalarCheck"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "x",
            "check"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "slopeAt"
            },
            "x": {
              "type": "number"
            },
            "check": {
              "$ref": "#/$defs/scalarCheck"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "direction"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "monotonic"
            },
            "direction": {
              "enum": [
                "increasing",
                "decreasing"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "level"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "crosses"
            },
            "level": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      ]
    },
    "acCheck": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "f",
            "check"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "gainAt"
            },
            "f": {
              "type": "number"
            },
            "check": {
              "$ref": "#/$defs/scalarCheck"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "f",
            "check"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "phaseAt"
            },
            "f": {
              "type": "number"
            },
            "check": {
              "$ref": "#/$defs/scalarCheck"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "check"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "bandwidth3dB"
            },
            "check": {
              "$ref": "#/$defs/scalarCheck"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "check"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "unityGainFrequency"
            },
            "check": {
              "$ref": "#/$defs/scalarCheck"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "check"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "phaseMargin"
            },
            "check": {
              "$ref": "#/$defs/scalarCheck"
            }
          }
        }
      ]
    },
    "tranCheck": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "target",
            "tol",
            "by"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "settleWithin"
            },
            "target": {
              "type": "number"
            },
            "tol": {
              "type": "number"
            },
            "by": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "neverExceed"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "stayAbove"
            },
            "value": {
              "type": "number"
            },
            "from": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "stayBelow"
            },
            "value": {
              "type": "number"
            },
            "from": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "amplitude"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "rippleBelow"
            },
            "amplitude": {
              "type": "number"
            },
            "from": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "value",
            "tol"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "finalCloseTo"
            },
            "value": {
              "type": "number"
            },
            "tol": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "t",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "logicAt"
            },
            "t": {
              "type": "number"
            },
            "value": {
              "enum": [
                0,
                1,
                "X",
                "Z"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "edge"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "logicEdges"
            },
            "edge": {
              "enum": [
                "rising",
                "falling",
                "both"
              ]
            },
            "from": {
              "type": "number"
            },
            "to": {
              "type": "number"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "value",
            "tol"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "logicFrequency"
            },
            "value": {
              "type": "number"
            },
            "tol": {
              "type": "number"
            },
            "from": {
              "type": "number"
            },
            "to": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "value",
            "tol"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "logicDutyCycle"
            },
            "value": {
              "type": "number"
            },
            "tol": {
              "type": "number"
            },
            "from": {
              "type": "number"
            },
            "to": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "from",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "logicStable"
            },
            "from": {
              "type": "number"
            },
            "to": {
              "type": "number"
            },
            "value": {
              "enum": [
                0,
                1,
                "X",
                "Z"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "serialContains"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "by": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "serialNotContains"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "pattern"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "serialMatches"
            },
            "pattern": {
              "type": "string"
            },
            "flags": {
              "type": "string",
              "pattern": "^[imsuy]*$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "serialLines"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "tranConfig": {
      "type": "object",
      "required": [
        "tstop",
        "dt"
      ],
      "additionalProperties": false,
      "properties": {
        "tstop": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxStep": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minStep": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "method": {
          "enum": [
            "trap",
            "be"
          ]
        },
        "ic": {
          "enum": [
            "zero",
            "op"
          ]
        },
        "reltol": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "dcConfig": {
      "type": "object",
      "required": [
        "from",
        "to",
        "points"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/id"
        },
        "param": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "type": "number"
        },
        "to": {
          "type": "number"
        },
        "points": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10001
        }
      },
      "oneOf": [
        {
          "required": [
            "source"
          ]
        },
        {
          "required": [
            "param"
          ]
        }
      ]
    },
    "acConfig": {
      "type": "object",
      "required": [
        "from",
        "to",
        "pointsPerDecade"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "to": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pointsPerDecade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "assertionBase": {
      "type": "object",
      "required": [
        "id",
        "stage",
        "probe",
        "check"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "probe": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\..+)?$",
          "description": "'<id>.i' / '<id>.v', a semiconductor device quantity '<id>.<q>' (e.g. 'Q1.ic', 'Q1.vbe', 'M1.vgs', 'D1.p'; circuitsvibe catalog <type> lists them), '<id>.<pin>' (a logic IC, primitive, VHDL-block or MCU pin, e.g. 'U1.1Y', 'U2.q[0]', 'U1.D13'), a named net, or — for serial checks — the id of a microcontroller ('U1')"
        },
        "at": {
          "type": "string"
        }
      }
    },
    "assertion": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/assertionBase"
            }
          ],
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": true,
            "probe": true,
            "at": true,
            "stage": {
              "const": "op"
            },
            "check": {
              "$ref": "#/$defs/scalarCheck"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/assertionBase"
            }
          ],
          "type": "object",
          "required": [
            "dc"
          ],
          "additionalProperties": false,
          "properties": {
            "id": true,
            "probe": true,
            "at": true,
            "stage": {
              "const": "dc"
            },
            "check": {
              "$ref": "#/$defs/dcCheck"
            },
            "dc": {
              "$ref": "#/$defs/dcConfig"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/assertionBase"
            }
          ],
          "type": "object",
          "required": [
            "ac"
          ],
          "additionalProperties": false,
          "properties": {
            "id": true,
            "probe": true,
            "at": true,
            "stage": {
              "const": "ac"
            },
            "check": {
              "$ref": "#/$defs/acCheck"
            },
            "ac": {
              "$ref": "#/$defs/acConfig"
            },
            "ref": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.(i|v))?$"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/assertionBase"
            }
          ],
          "type": "object",
          "required": [
            "tran"
          ],
          "additionalProperties": false,
          "properties": {
            "id": true,
            "probe": true,
            "at": true,
            "stage": {
              "const": "tran"
            },
            "check": {
              "$ref": "#/$defs/tranCheck"
            },
            "tran": {
              "$ref": "#/$defs/tranConfig"
            }
          }
        }
      ]
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "layout": {
      "description": "Viewer-only placement hints; never affect simulation. Extra (viewer-owned) fields are allowed.",
      "type": "object",
      "properties": {
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "rotation": {
                "enum": [
                  0,
                  90,
                  180,
                  270
                ]
              },
              "flip": {
                "type": "boolean"
              }
            }
          }
        },
        "wires": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*\\.[^.]+$"
              },
              "to": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*\\.[^.]+$"
              },
              "points": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/point"
                }
              }
            }
          }
        }
      }
    },
    "pcb": {
      "description": "The printed circuit board (tb.board / tb.place): board, placement per component id, custom footprints. Lengths in millimetres, angles in degrees counter-clockwise, origin at the lower-left corner of a rectangular board, y up. Spec: docs/PCB.md. Cross-field rules (placements name components, footprint names resolve) are checked by validateCircuitDoc.",
      "type": "object",
      "required": [
        "board",
        "placements"
      ],
      "additionalProperties": false,
      "properties": {
        "board": {
          "$ref": "#/$defs/pcbBoard"
        },
        "placements": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/pcbPlacement"
          }
        },
        "footprints": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/pcbFootprint"
          }
        }
      }
    },
    "pcbXY": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "pcbBoard": {
      "description": "Rectangle { width, height, cornerRadius? }, a polygon { outline }, or { preset: \"uno-shield\" }; defaults: layers 2, thickness 1.6, tech \"tht\", rules { trace 0.25, clearance 0.2, via { drill 0.3, diameter 0.6 }, edgeClearance 0.5 }, holes []; autorouted unless route: false, traces sized from the simulated current (rules.copper 1 oz, rules.tempRise 10 °C, rules.grid 0.25) or nets { <net>: { width } }.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cornerRadius": {
          "type": "number",
          "minimum": 0
        },
        "outline": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/pcbXY"
          }
        },
        "preset": {
          "enum": [
            "uno-shield"
          ]
        },
        "layers": {
          "enum": [
            1,
            2
          ]
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tech": {
          "enum": [
            "tht",
            "smd"
          ]
        },
        "holes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "d"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "d": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trace": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "clearance": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "edgeClearance": {
              "type": "number",
              "minimum": 0
            },
            "via": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "drill": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "diameter": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "copper": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 10,
              "description": "copper weight, oz/ft² (default 1 = 35 µm); sizes the current a trace carries"
            },
            "tempRise": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "description": "allowed trace temperature rise, °C (default 10), for the IPC-2221 current check"
            },
            "grid": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1.27,
              "description": "autorouter grid pitch, mm (default 0.25)"
            }
          }
        },
        "nets": {
          "type": "object",
          "description": "per-net trace widths by net name (tb.name): { vcc: { width: 0.8 } }, mm; default: sized from the simulated current",
          "additionalProperties": {
            "type": "object",
            "required": [
              "width"
            ],
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "number",
                "minimum": 0.1
              }
            }
          }
        },
        "route": {
          "const": false,
          "description": "false: no autorouting (placement checks and the ratsnest only); absent: autoroute"
        }
      }
    },
    "pcbPlacement": {
      "description": "Footprint origin x/y (mm; absent = not placed yet, P805), rot (degrees CCW), side, footprint name, pin → pad overrides; or { offBoard: true }.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "rot": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "side": {
          "enum": [
            "top",
            "bottom"
          ]
        },
        "footprint": {
          "type": "string",
          "minLength": 1
        },
        "pads": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "offBoard": {
          "const": true
        },
        "at": {
          "type": "string",
          "description": "Origin location (file:line of the tb.place call). Informational; dropped from share links."
        }
      }
    },
    "pcbPad": {
      "type": "object",
      "required": [
        "name",
        "x",
        "y",
        "w"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "shape": {
          "enum": [
            "rect",
            "circle",
            "oval",
            "roundrect"
          ]
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "drill": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "pcbFootprint": {
      "description": "A custom land pattern (footprint-local mm): pads, optional courtyard rectangles (default: the pads plus 0.25 mm), mounting holes, silkscreen.",
      "type": "object",
      "required": [
        "name",
        "pads"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "description": {
          "type": "string"
        },
        "tech": {
          "enum": [
            "tht",
            "smd"
          ]
        },
        "pads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pcbPad"
          }
        },
        "courtyard": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "w",
              "h"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "holes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "d"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "d": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "silk": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "points"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "line"
                  },
                  "points": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "$ref": "#/$defs/pcbXY"
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "x",
                  "y",
                  "r"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "circle"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "r": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            ]
          }
        }
      }
    },
    "definitions": {
      "description": "Custom components (defineComponent parts) used by components[].type, ascending type. Each one is CODE: the module at `source` (in sources[]) exports the definition; reading the document needs only the declaration, simulating it evaluates the module (the CLI only with --allow-code). `registry` is the provenance of a part installed from the component registry.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "pins",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "$ref": "#/$defs/id"
          },
          "pins": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "unique pin names (checked by validateCircuitDoc)"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "export": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
          },
          "registry": {
            "type": "object",
            "required": [
              "ref",
              "hash"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,31}/[a-z][a-z0-9-]{1,39}@[0-9]+$"
              },
              "hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
